hubble <- data.frame(
distance = c(
504.1,
655.0,
643.4,
582.1,
600.3,
542.7,
660.4,
638.2,
500.5,
568.2,
589.8
),
velocity = c(
22952.7,
43787.7,
38095.8,
24562.8,
48847.5,
32814.3,
48982.8,
38084.1,
32700.9,
32940.6,
32014.8
)
)
# Summary Stats
x_bar = mean(hubble$distance)
y_bar = mean(hubble$velocity)
s_x = sd(hubble$distance)
s_y = sd(hubble$velocity)
s_xy = cov(hubble$distance, hubble$velocity)
r_xy = cor(hubble$distance, hubble$velocity)
# Least Squares
( b1_hat = r_xy * s_y / s_x )
( b0_hat = y_bar - b1_hat * x_bar )
# Fit a model
model = lm(hubble$velocity~hubble$distance)
e_vec = model$residuals
e_sd = sqrt((11-2)^-1 * sum(e_vec^2))
View(hubble)
View(hubble)
summary(model)
confint(model, "x", level = 0.95)
confint(model, "distance", level = 0.95)
confiwhat nt(model, "hubble$distance", level = 0.95)
confint(model, "hubble$distance", level = 0.95)
abline(model, col = "red", lwd = 2)
plot(hubble$distance, hubble$velocity,
xlab = "Distance", ylab = "Velocity",
main = "Velocity vs Distance",
pch = 19)
plot(hubble$distance, hubble$velocity,
xlab = "Distance", ylab = "Velocity",
main = "Velocity vs Distance",
pch = 19)
abline(model, col = "red", lwd = 2)
abline(h = 0, col = "red", lty = 2)
plot(model$fitted.values, e_vec,
xlab = "Fitted Values", ylab = "Residuals",
main = "Residuals vs Fitted Values",
pch = 19)
plot(hubble$distance, e_vec,
xlab = "Distance", ylab = "Residuals",
main = "Residuals vs Distance",
pch = 19)
