View(acov)
cov_matrix = vcov(acov)
var_a = acov[8, 8] + acov[6, 6] - 2 * acov[6, 8]
sqrt(var_a)
var_b = acov[8, 8] + acov[6, 6] + 4 * acov[9, 9] + 2 * acov(6, 8) - 4 * acov[8, 9] - 4 * acov[6, 9]
