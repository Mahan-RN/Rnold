# subset: fathers (x) within 2.5 cm of 180 (inclusive)
subset_idx = which(x >= 180 - 2.5 & x <= 180 + 2.5)
# corresponding sons' heights (y)
y_subset = y[subset_idx]
# sample stats
ybar = mean(y_subset)
sy = sd(y_subset)
n_x = length(y_subset)
# approximate 95% CI using the formula ybar +/- 2*sy/sqrt(n)
lower = ybar - 2 * sy / sqrt(n_x)
upper = ybar + 2 * sy / sqrt(n_x)
cat("n =", n_x, "\n")
cat("ybar =", ybar, "\n")
cat("Lower endpoint:", lower, "\n")
cat("Upper endpoint:", upper, "\n")
